# URL da API FastAPI (local ou produção)
VITE_API_URL=http://localhost:8000

# Client ID do Google OAuth 2.0 (Google Cloud Console)
VITE_GOOGLE_CLIENT_ID=seu_client_id.apps.googleusercontent.com

# Login simulado apenas para desenvolvimento local
VITE_ENABLE_DEMO_LOGIN=false

# A credencial TMDB fica apenas no backend; o frontend usa os endpoints /tmdb da API.
